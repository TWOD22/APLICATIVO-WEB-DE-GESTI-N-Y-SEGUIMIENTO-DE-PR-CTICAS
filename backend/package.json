{
  "name": "sistema-practicas-udi-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=./src src/server.js",
    "start": "node src/server.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "migrate:up": "node-pg-migrate up -m src/database/migrations --no-single-transaction",
    "migrate:down": "node-pg-migrate down -m src/database/migrations",
    "migrate:create": "node-pg-migrate create -m src/database/migrations --migration-file-language sql",
    "probar:login": "node scripts/probar-login.mjs",
    "probar:storage": "node scripts/probar-storage.mjs",
    "cuestionario:ejemplo": "node scripts/cuestionario-ejemplo.mjs",
    "seed": "node src/database/seeds/run.js",
    "demo:crear": "node scripts/demo-datos.mjs crear",
    "demo:limpiar": "node scripts/demo-datos.mjs limpiar",
    "demo:reiniciar": "node scripts/demo-datos.mjs reiniciar"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {}
}
