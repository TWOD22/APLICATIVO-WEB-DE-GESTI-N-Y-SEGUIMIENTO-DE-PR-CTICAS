# ───────────────────────── Servidor ─────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Orígenes del frontend permitidos por CORS, separados por coma (sin "/" final)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8443
# Detrás de Render/Cloud Run/Koyeb usa 1 para que el rate limit vea la IP real
TRUST_PROXY=0
MAX_JSON_SIZE=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SIGNED_URL_TTL_SECONDS=900

# ───────────────────────── PostgreSQL ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/practicas_udi
# true para proveedores que exigen SSL (Neon, Supabase, Render)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ───────────────────────── Firebase Admin ─────────────────────────
# Consola Firebase → Configuración del proyecto → Cuentas de servicio → Generar clave privada.
# NUNCA subas estos valores al repositorio ni los pongas en variables VITE_*.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave entre comillas, con los saltos de línea como \n
FIREBASE_PRIVATE_KEY=
# (Ya no se usa para archivos: se guardan en Supabase Storage. Déjalo vacío.)
FIREBASE_STORAGE_BUCKET=
# Solo para scripts/probar-login.mjs (Configuración del proyecto → General → Clave de API web). No es secreta, pero no se usa en el servidor.
FIREBASE_WEB_API_KEY=

# ───────────────────────── Supabase Storage (archivos privados) ─────────────────────────
# Panel Supabase → Project Settings → API Keys. La clave secreta (sb_secret_...) NUNCA va al frontend ni al repositorio.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Bucket PRIVADO (sin acceso público)
SUPABASE_STORAGE_BUCKET=

# ───────────────────────── Seed del Director inicial (opcional) ─────────────────────────
# Crea primero el usuario en Firebase Authentication y copia su UID.
SEED_DIRECTOR_FIREBASE_UID=
SEED_DIRECTOR_DOCUMENTO=
SEED_DIRECTOR_NOMBRES=
SEED_DIRECTOR_APELLIDOS=
SEED_DIRECTOR_CORREO=

# ───────────────────────── Pruebas ─────────────────────────
# Base EXCLUSIVA para pruebas (su nombre debe contener "test"): se borra y recrea en cada ejecución.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/practicas_udi_test
