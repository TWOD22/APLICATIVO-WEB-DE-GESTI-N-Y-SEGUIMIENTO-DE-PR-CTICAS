rules_version = '2';
// Base propia del servicio de notificaciones y auditoría: nadie accede desde el navegador ni desde la app.
// Solo el servicio (Firebase Admin, que ignora estas reglas) lee y escribe.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
